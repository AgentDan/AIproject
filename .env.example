PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# --- Platform / RAG ---
EMBEDDINGS_PROVIDER=stub
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small
KB_TOP_K=5
# KB_INDEX_PATH=
# SERVER_STORAGE_DIR=
# CORS_ORIGIN=https://example.com
# CLIENT_DIST_PATH=

# --- MongoDB (auth / admin из mvp3dcursor) ---
# Без MONGO_URI в development: auth в памяти + apps/server/data/dev-users.json (admin/admin по умолчанию)
# MONGO_URI=mongodb://127.0.0.1:27017/mvp3dcursor

# --- Cloudflare R2 / S3 (models, Panel Lab) ---
# AWS_REGION=auto
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BUCKET_NAME=

# --- Auth (фаза 1+) ---
# JWT_SECRET=change-me-in-production
# JWT_EXPIRES_IN=7d
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=30
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=200

# --- Panel Lab temp files ---
# LAB_TMP_DIR=

# --- Production checklist ---
# NODE_ENV=production
# CORS_ORIGIN=https://your-domain.com
# JWT_SECRET=<strong-random-secret>   # обязателен для login
# CLIENT_DIST_PATH=                   # default: apps/client/dist
# См. docs/deploy-production.md
